{
  "name": "@farming-labs/capvine",
  "version": "0.0.1",
  "description": "Delegated, resource-bound authorization for applications and services.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "example": "tsx examples/delegation.ts",
    "example:inspection": "tsx examples/inspection.ts",
    "example:network": "tsx examples/network/demo.ts",
    "check": "npm run format:check && npm run typecheck && npm test && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "example:service": "tsx examples/service.ts",
    "example:github": "tsx examples/github.ts",
    "example:mcp": "tsx examples/mcp.ts",
    "server": "tsx src/cli.ts",
    "example:resources": "tsx examples/resources.ts",
    "package:check": "node scripts/check-package.mjs",
    "example:accounts": "tsx examples/accounts/demo.ts",
    "example:slack": "tsx examples/slack/demo.ts",
    "example:plugins": "npm run build && tsx examples/plugins/demo.ts",
    "console:accounts": "tsx examples/account-console.ts",
    "console:workflows": "npm run build && tsx examples/workflow-console.ts",
    "playground": "tsx examples/delegation-playground/main.ts",
    "example:recovery": "tsx examples/recovery.ts",
    "provider:check": "tsx examples/provider-validation/main.ts",
    "provider:lifecycle": "tsx examples/provider-validation/lifecycle-main.ts",
    "release:bundle": "npm run build && node scripts/check-package.mjs --output",
    "example:application": "tsx examples/application/demo.ts",
    "console:application": "npm run build && tsx examples/application/console.ts",
    "deployment:check": "tsx examples/deployment/main.ts",
    "release:status": "tsx examples/release/main.ts"
  },
  "exports": {
    "./setup": {
      "types": "./dist/setup.d.ts",
      "default": "./dist/setup.js"
    },
    "./providers": {
      "types": "./dist/providers.d.ts",
      "default": "./dist/providers.js"
    },
    "./resources": {
      "types": "./dist/resources.d.ts",
      "default": "./dist/resources.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sqlite": {
      "types": "./dist/sqlite.d.ts",
      "default": "./dist/sqlite.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "default": "./dist/http.js"
    },
    "./service": {
      "types": "./dist/service.d.ts",
      "default": "./dist/service.js"
    },
    "./administration": {
      "types": "./dist/administration.d.ts",
      "default": "./dist/administration.js"
    },
    "./identity-file": {
      "types": "./dist/identity-file.d.ts",
      "default": "./dist/identity-file.js"
    },
    "./github": {
      "types": "./dist/github.d.ts",
      "default": "./dist/github.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "default": "./dist/mcp.js"
    },
    "./adapter": {
      "types": "./dist/adapter.d.ts",
      "default": "./dist/adapter.js"
    },
    "./filesystem": {
      "types": "./dist/filesystem.d.ts",
      "default": "./dist/filesystem.js"
    },
    "./postgres": {
      "types": "./dist/postgres.d.ts",
      "default": "./dist/postgres.js"
    },
    "./configuration": {
      "types": "./dist/configuration.d.ts",
      "default": "./dist/configuration.js"
    },
    "./approvals": {
      "types": "./dist/approvals.d.ts",
      "default": "./dist/approvals.js"
    },
    "./accounts": {
      "types": "./dist/accounts.d.ts",
      "default": "./dist/accounts.js"
    },
    "./oauth": {
      "types": "./dist/oauth.d.ts",
      "default": "./dist/oauth.js"
    },
    "./gmail": {
      "types": "./dist/gmail.d.ts",
      "default": "./dist/gmail.js"
    },
    "./slack": {
      "types": "./dist/slack.d.ts",
      "default": "./dist/slack.js"
    },
    "./workflows": {
      "types": "./dist/workflows.d.ts",
      "default": "./dist/workflows.js"
    },
    "./workflow-console": {
      "types": "./dist/workflow-console.d.ts",
      "default": "./dist/workflow-console.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "default": "./dist/worker.js"
    },
    "./account-console": {
      "types": "./dist/account-console.d.ts",
      "default": "./dist/account-console.js"
    },
    "./client": {
      "types": "./dist/owner-client.d.ts",
      "default": "./dist/owner-client.js"
    },
    "./plugins": {
      "types": "./dist/plugins.d.ts",
      "default": "./dist/plugins.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./owner-console": {
      "types": "./dist/owner-console.d.ts",
      "default": "./dist/owner-console.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/farming-labs/capvine.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/pg": "8.23.1",
    "@ucanto/client": "9.0.2",
    "@ucanto/core": "10.4.5",
    "@ucanto/principal": "9.0.3",
    "@ucanto/validator": "10.0.1",
    "oauth4webapi": "3.8.8",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "bin": {
    "capvine": "./dist/cli.js"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "latest"
  }
}
